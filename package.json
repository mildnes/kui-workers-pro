{
  "name": "kui-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./static/tailwind.css --content ./static/index.html --minify",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test tests/*.test.js",
    "check": "npm test && node --check 'functions/api/[[path]].js' && python3 -m py_compile static/vps/*.py && bash -n static/vps/*.sh && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17",
    "wrangler": "^4.120.1"
  }
}
